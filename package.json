{
  "name": "dsh-ccx",
  "version": "0.9.0",
  "description": "DSH 桌面版背景主题插件：给 DeepSeek Harness 0.2.2+ 换上动态背景——13 种同步 code-codex 上游的原版场景渲染器（新增 ASCII 字符砖块 / 浅海字迹 / 光谱帷幔）、壁纸视频素材库、UI 表面分区透明与 Windows 标题栏适配，以及原版复刻设置面板。",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:dev": "node scripts/build.mjs --dev",
    "typecheck": "tsc --noEmit",
    "test": "node test/host-smoke.test.mjs && node test/client-unit.test.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "appearance",
    "background",
    "theme",
    "wallpaper",
    "desktop"
  ],
  "type": "module",
  "main": "./lib/index.js",
  "icon": "./assets/icon.svg",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "assets",
    "cordis.patch.yml",
    "tsconfig.json",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Witherwithwinter/dsh-ccx.git"
  },
  "bugs": {
    "url": "https://github.com/Witherwithwinter/dsh-ccx/issues"
  },
  "homepage": "https://github.com/Witherwithwinter/dsh-ccx#readme",
  "author": "Witherwithwinter",
  "license": "MIT",
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0",
    "typescript": "^7.0.2"
  }
}
