{
  "name": "dsh-ccx",
  "version": "0.8.9",
  "description": "DSH 桌面版背景主题插件：给 DeepSeek Harness 换上动态背景——10 种原版场景渲染器（银河 / 辉光地平线 / 层峦 / 云穹 / 极光电离层 / 黑洞 / 云列车 / 粒子成像 / 像素雕塑 / 闪烁方块）、壁纸视频素材库、UI 表面分区透明，以及逐像素复刻的 Appearance 设置面板。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "appearance",
    "background",
    "theme",
    "wallpaper",
    "desktop"
  ],
  "type": "module",
  "main": "./lib/index.js",
  "icon": "./assets/icon.svg",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "assets",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Witherwithwinter/dsh-ccx.git"
  },
  "bugs": {
    "url": "https://github.com/Witherwithwinter/dsh-ccx/issues"
  },
  "homepage": "https://github.com/Witherwithwinter/dsh-ccx#readme",
  "author": "Witherwithwinter",
  "license": "MIT",
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "devDependencies": {
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0"
  }
}
